    // BEGIN FLOWBUDGET CLOUD
    function fbSignedIn() { return request.auth != null; }
    function fbShape(value) {
      return value.keys().hasOnly(['name', 'ownerId', 'accessKey', 'dataJSON', 'revision', 'createdAt', 'updatedAt'])
        && value.name is string && value.name.size() > 0 && value.name.size() <= 100
        && value.dataJSON is string && value.dataJSON.size() <= 750000
        && value.revision is int && value.revision >= 0
        && value.createdAt is timestamp && value.updatedAt is timestamp;
    }
    match /flowBudgets/{budgetId} {
      allow read: if fbSignedIn();
      allow create: if fbSignedIn() && fbShape(request.resource.data) && request.resource.data.revision == 0;
      allow update: if fbSignedIn() && fbShape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'dataJSON', 'revision', 'updatedAt'])
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /flowBudgetWorkspace/{workspaceId} {
      allow read: if fbSignedIn() && workspaceId == 'household';
      allow create, update: if fbSignedIn() && workspaceId == 'household'
        && request.resource.data.keys().hasOnly(['activeBudgetId'])
        && request.resource.data.activeBudgetId is string;
      allow delete: if false;
    }
    // END FLOWBUDGET CLOUD
