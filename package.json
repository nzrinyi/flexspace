{
  "name": "carmatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "firebase:apps:create": "firebase apps:create WEB \"Quorum Web\" --project quorum-2",
    "firebase:apps:sdkconfig": "firebase apps:sdkconfig WEB 1:594173636153:web:cf3c1d2aadde06508167e8 --project quorum-2",
    "deploy": "npm run build && firebase deploy --only hosting --project quorum-2",
    "deploy:rules": "firebase deploy --only firestore:rules --project quorum-2"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "latest",
    "@vitejs/plugin-react": "latest"
  }
}
